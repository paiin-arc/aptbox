# ---- Shelby (Geomi) ----
# Get from https://geomi.dev (Shelby's project dashboard).
NEXT_PUBLIC_SHELBY_API_KEY=

# ---- Network ----
# The app runs on shelbynet only: Shelby retired testnet in SDK 0.6.0, and
# "shelbynet" is the only supported value. Leave NEXT_PUBLIC_DEFAULT_NETWORK
# unset — any other value is ignored and falls back to shelbynet.
#
# Most wallets (Petra, Pontem, Nightly) don't ship with Shelbynet
# preconfigured. Add it as a custom network in your wallet:
#   Name:    Shelbynet
#   RPC:     https://api.shelbynet.shelby.xyz/v1
#   Faucet:  https://faucet.shelbynet.shelby.xyz
#   Chain ID: (check faucet response)
# NEXT_PUBLIC_DEFAULT_NETWORK=shelbynet

# ---- Registry ----
# The deployer address of the Move package on shelbynet. The live one is:
#   0x2251165b1dd4124e02304bd781779070e87af21aa86f69c1f6d452d4d8bd2e5c
NEXT_PUBLIC_REGISTRY_ADDRESS_SHELBYNET=

# Optional: your real URL, for Open Graph tags.
# NEXT_PUBLIC_SITE_URL=https://aptbox.vercel.app

# ─── AI overlay (NOT IMPLEMENTED) ────────────────────────────────────────
# Nothing in this codebase reads the variables below yet; they are kept as a
# placeholder for a planned feature. You can leave them empty.
# Master kill switch. Leave false until everything below is configured.
# When false, the entire AI feature set is invisible to users and API.
NEXT_PUBLIC_AI_FEATURES_ENABLED=false
AI_FEATURES_ENABLED=false

# Supabase (DB + pgvector). See SETUP_AI.md for setup steps.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers. ANTHROPIC for summaries/chat, OPENAI for embeddings only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Shelby keys for server-side file fetching (used by the Inngest worker).
# Use the SAME AG- key values as the client-side NEXT_PUBLIC_SHELBY_API_KEY.
SHELBY_API_KEY=
SHELBY_API_KEY_SHELBYNET=
SHELBY_API_KEY_TESTNET=

# Inngest job runner. Free tier is plenty for early users.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional: skip AI processing for files larger than this (default 8 MB).
AI_MAX_FILE_BYTES=8388608
